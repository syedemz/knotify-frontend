{
  "environment": "prod",
  "region": "eu-central-1",
  "cognito": {
    "region": "eu-central-1",
    "userPoolId": "<FILL_COGNITO_USER_POOL_ID>",
    "appClientId": "<FILL_COGNITO_APP_CLIENT_ID>",
    "appClientHasSecret": false
  },
  "restApi": {
    "baseUrl": "https://<FILL_PROD_CUSTOM_DOMAIN>/v1",
    "auth": {
      "mode": "COGNITO_JWT",
      "headerName": "Authorization",
      "tokenPrefix": "Bearer"
    }
  },
  "appsync": {
    "graphqlUrl": "https://<FILL_APPSYNC_API_ID>.appsync-api.eu-central-1.amazonaws.com/graphql",
    "realtimeUrl": "wss://<FILL_APPSYNC_API_ID>.appsync-realtime-api.eu-central-1.amazonaws.com/graphql",
    "auth": {
      "headerName": "Authorization"
    }
  },
  "pushNotifications": {
    "registerEndpoint": "/v1/push-tokens"
  },
  "media": {
    "readPhotoCloudFrontDomain": "<FILL_PHOTO_CLOUDFRONT_DOMAIN>"
  }
}
