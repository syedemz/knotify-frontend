{
  "expo": {
    "name": "knotify-frontend",
    "slug": "knotify-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.knotify.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Knotify uses your approximate location to show you compatible matches nearby"
      }
    },
    "android": {
      "package": "com.knotify.app",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-secure-store",
      "expo-localization",
      "expo-splash-screen",
      "expo-location"
    ]
  }
}
