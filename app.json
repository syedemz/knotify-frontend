{
  "expo": {
    "name": "knotify-frontend",
    "slug": "knotify-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.knotify.app"
    },
    "android": {
      "package": "com.knotify.app"
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-secure-store",
      "expo-localization",
      "expo-splash-screen"
    ]
  }
}
